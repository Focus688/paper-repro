# 复制为 .env 后填入自己的 key（.env 已被 .gitignore 排除）
# 两个 key 都是可选：只跑其中一个模型时，只填对应的即可。

# OverclaimBench 复现（overclaim/repro.py）
# 端点：https://api.deepseek.com/v1
DEEPSEEK_API_KEY=

# 端点：https://open.bigmodel.cn/api/coding/paas/v4（coding plan key，通用端点会 429）
GLM_API_KEY=

# 说明：脚本用标准库读取环境变量，不依赖 python-dotenv。
# 也可以直接 export DEEPSEEK_API_KEY=... 后运行，无需创建 .env。
